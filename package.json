{
  "name": "followloop-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FollowLoop.ai Monorepo Workspace containing NestJS Backend and Vite React Frontend",
  "scripts": {
    "dev:backend": "cd backend && npm run start:dev",
    "dev:frontend": "cd frontend/followloop && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend/followloop && npm run build",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:studio": "cd backend && npx prisma studio"
  }
}
