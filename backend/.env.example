# Environment Configuration for FollowLoop.ai Backend

PORT=3001
NODE_ENV=development

# Database Connection (Neon / Supabase PostgreSQL Free Tier)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/followloop_db?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="super-secret-jwt-key-followloop-change-in-production"
JWT_EXPIRES_IN="7d"

# AI Engine Configuration
GROQ_API_KEY="gsk_your_groq_api_key"
AI_MODEL="llama-3.3-70b-versatile"

# Resend Email Service (Free Tier)
RESEND_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM="FollowLoop.ai <notifications@resend.dev>"

# Sentry Exception Monitoring
SENTRY_DSN="https://your-sentry-dsn@o0.ingest.sentry.io/0"

# Application Settings
FRONTEND_URL="http://localhost:3000"
